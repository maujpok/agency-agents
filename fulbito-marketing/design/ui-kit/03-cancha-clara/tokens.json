{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Cancha Clara",
    "id": "fulbito.ui-kit.03-cancha-clara",
    "version": "1.0.0",
    "project": "FulbitoApp",
    "direction": "03 — Cancha Clara",
    "concept": "Utilitaria, clara, rápida. Un solo acento. La tipografía carga la identidad.",
    "platform": ["flutter", "ios", "android"],
    "baseUnit": 4,
    "unit": "dp/sp",
    "defaultMode": "light",
    "author": "UI Designer · NEXUS",
    "date": "2026-08-22"
  },

  "primitive": {
    "azul": {
      "velo":      { "value": "#F3F6FF", "type": "color", "comment": "Tinte mínimo. Fondo del bloque de IA." },
      "tinta":     { "value": "#E8EDFF", "type": "color", "comment": "Tinte de acento. Pressed de terciario." },
      "claro":     { "value": "#95AAFF", "type": "color", "comment": "Acento pressed en modo oscuro." },
      "medio":     { "value": "#6E8CFF", "type": "color", "comment": "Acento en modo oscuro. 6.6:1 sobre cal-1000." },
      "base":      { "value": "#1B4DFF", "type": "color", "comment": "Acento primario. 5.9:1 sobre blanco." },
      "presionado":{ "value": "#1339CC", "type": "color", "comment": "Pressed en modo claro. 8.5:1 con blanco." },
      "hundido":   { "value": "#0E2B99", "type": "color", "comment": "Texto de acento sobre tinte." },
      "nocturno":  { "value": "#1A2140", "type": "color", "comment": "Tinte de acento en modo oscuro." }
    },
    "cal": {
      "0":    { "value": "#FFFFFF", "type": "color" },
      "25":   { "value": "#FAFBFC", "type": "color" },
      "50":   { "value": "#F4F6F8", "type": "color" },
      "100":  { "value": "#EAEDF1", "type": "color" },
      "200":  { "value": "#DCE0E7", "type": "color" },
      "300":  { "value": "#C3C9D4", "type": "color" },
      "400":  { "value": "#98A2B3", "type": "color" },
      "500":  { "value": "#6B7688", "type": "color" },
      "600":  { "value": "#57616F", "type": "color" },
      "700":  { "value": "#3E4653", "type": "color" },
      "800":  { "value": "#2A303A", "type": "color" },
      "900":  { "value": "#191D24", "type": "color" },
      "1000": { "value": "#0F1115", "type": "color" }
    },
    "noche": {
      "bg":            { "value": "#0F1115", "type": "color" },
      "surface":       { "value": "#15181E", "type": "color" },
      "surfaceRaised": { "value": "#1C2028", "type": "color" },
      "border":        { "value": "#252A33", "type": "color" },
      "borderStrong":  { "value": "#39404C", "type": "color" },
      "textPrimary":   { "value": "#F4F6F8", "type": "color" },
      "textSecondary": { "value": "#A8B1C0", "type": "color" },
      "textTertiary":  { "value": "#8A93A3", "type": "color" },
      "textDisabled":  { "value": "#5A6272", "type": "color" }
    },
    "semantico": {
      "confirmado":     { "value": "#0E7A4B", "type": "color", "comment": "Éxito · texto y borde · 5.4:1 con blanco" },
      "confirmadoFill": { "value": "#E3F5EC", "type": "color" },
      "confirmadoDark": { "value": "#35C98B", "type": "color", "comment": "8.9:1 sobre noche.bg" },
      "corto":          { "value": "#C2183C", "type": "color", "comment": "Error · 6.0:1 con blanco" },
      "cortoFill":      { "value": "#FDE8EC", "type": "color" },
      "cortoDark":      { "value": "#FF6B85", "type": "color", "comment": "6.9:1 sobre noche.bg" },
      "ojo":            { "value": "#9A5B00", "type": "color", "comment": "Advertencia · texto · 5.4:1 con blanco" },
      "ojoStrong":      { "value": "#E8A317", "type": "color", "comment": "Advertencia · relleno · 8.7:1 con cal-1000" },
      "ojoFill":        { "value": "#FDF0D9", "type": "color" },
      "ojoDark":        { "value": "#F5B33C", "type": "color", "comment": "10.3:1 sobre noche.bg" },
      "dato":           { "value": "#00707F", "type": "color", "comment": "Info · 5.8:1 con blanco" },
      "datoFill":       { "value": "#E0F4F6", "type": "color" },
      "datoDark":       { "value": "#3FC7D6", "type": "color", "comment": "9.3:1 sobre noche.bg" }
    }
  },

  "color": {
    "accent": {
      "default":  { "light": "{primitive.azul.base}",       "dark": "{primitive.azul.medio}" },
      "pressed":  { "light": "{primitive.azul.presionado}", "dark": "{primitive.azul.claro}" },
      "onAccent": { "light": "{primitive.cal.0}",           "dark": "{primitive.cal.1000}" },
      "muted":    { "light": "{primitive.azul.tinta}",      "dark": "{primitive.azul.nocturno}" },
      "veil":     { "light": "{primitive.azul.velo}",       "dark": "{primitive.azul.nocturno}" },
      "onMuted":  { "light": "{primitive.azul.hundido}",    "dark": "{primitive.azul.medio}" },
      "disabled": { "light": "{primitive.cal.100}",         "dark": "{primitive.noche.border}" }
    },
    "surface": {
      "canvas":    { "light": "{primitive.cal.25}",   "dark": "{primitive.noche.bg}",            "comment": "Fondo del scaffold" },
      "primary":   { "light": "{primitive.cal.0}",    "dark": "{primitive.noche.surface}",       "comment": "Tarjetas, campos, bottom nav" },
      "raised":    { "light": "{primitive.cal.0}",    "dark": "{primitive.noche.surfaceRaised}", "comment": "Sheets, menús, diálogos" },
      "sunken":    { "light": "{primitive.cal.50}",   "dark": "{primitive.noche.bg}",            "comment": "Campos disabled, skeletons" },
      "neutral":   { "light": "{primitive.cal.100}",  "dark": "{primitive.noche.border}",        "comment": "Chips, avatar placeholder" },
      "inverse":   { "light": "{primitive.cal.900}",  "dark": "{primitive.noche.surfaceRaised}", "comment": "Snackbar, tooltip" },
      "onInverse": { "light": "{primitive.cal.0}",    "dark": "{primitive.noche.textPrimary}" },
      "scrim":     { "light": "rgba(15,17,21,0.40)",  "dark": "rgba(0,0,0,0.60)" }
    },
    "text": {
      "primary":   { "light": "{primitive.cal.1000}", "dark": "{primitive.noche.textPrimary}",   "contrastOnSurface": { "light": "18.9:1", "dark": "17.4:1" } },
      "secondary": { "light": "{primitive.cal.600}",  "dark": "{primitive.noche.textSecondary}", "contrastOnSurface": { "light": "6.3:1",  "dark": "8.7:1" } },
      "tertiary":  { "light": "{primitive.cal.500}",  "dark": "{primitive.noche.textTertiary}",  "contrastOnSurface": { "light": "4.6:1",  "dark": "5.9:1" } },
      "emphasis":  { "light": "{primitive.cal.800}",  "dark": "{primitive.noche.textPrimary}" },
      "disabled":  { "light": "{primitive.cal.400}",  "dark": "{primitive.noche.textDisabled}",  "comment": "Exento de WCAG. Nunca informativo." },
      "link":      { "light": "{primitive.azul.base}","dark": "{primitive.azul.medio}" },
      "onAccent":  { "light": "{primitive.cal.0}",    "dark": "{primitive.cal.1000}" }
    },
    "icon": {
      "default":  { "light": "{primitive.cal.700}", "dark": "{primitive.noche.textSecondary}" },
      "subtle":   { "light": "{primitive.cal.400}", "dark": "{primitive.noche.textDisabled}" },
      "active":   { "light": "{primitive.azul.base}", "dark": "{primitive.azul.medio}" },
      "onAccent": { "light": "{primitive.cal.0}", "dark": "{primitive.cal.1000}" }
    },
    "border": {
      "subtle":       { "light": "{primitive.cal.200}", "dark": "{primitive.noche.border}",       "comment": "Divisores, borde de tarjeta" },
      "default":      { "light": "{primitive.cal.300}", "dark": "{primitive.noche.border}",       "comment": "Campo de texto" },
      "strong":       { "light": "{primitive.cal.400}", "dark": "{primitive.noche.borderStrong}", "comment": "Botón secundario" },
      "highContrast": { "light": "{primitive.cal.500}", "dark": "{primitive.noche.textTertiary}", "comment": "Todos los bordes cuando MediaQuery.highContrast == true. Sube a 2dp." },
      "focus":        { "light": "{primitive.azul.base}", "dark": "{primitive.azul.medio}",       "comment": "Anillo 2dp, offset 2dp. 5.9:1 / 6.6:1" }
    },
    "feedback": {
      "success":     { "light": "{primitive.semantico.confirmado}",     "dark": "{primitive.semantico.confirmadoDark}" },
      "successFill": { "light": "{primitive.semantico.confirmadoFill}", "dark": "rgba(53,201,139,0.14)" },
      "error":       { "light": "{primitive.semantico.corto}",          "dark": "{primitive.semantico.cortoDark}" },
      "errorFill":   { "light": "{primitive.semantico.cortoFill}",      "dark": "rgba(255,107,133,0.14)" },
      "warning":     { "light": "{primitive.semantico.ojo}",            "dark": "{primitive.semantico.ojoDark}" },
      "warningBold": { "light": "{primitive.semantico.ojoStrong}",      "dark": "{primitive.semantico.ojoDark}" },
      "warningFill": { "light": "{primitive.semantico.ojoFill}",        "dark": "rgba(245,179,60,0.14)" },
      "info":        { "light": "{primitive.semantico.dato}",           "dark": "{primitive.semantico.datoDark}" },
      "infoFill":    { "light": "{primitive.semantico.datoFill}",       "dark": "rgba(63,199,214,0.14)" }
    },
    "state": {
      "hoverOverlay":   { "light": "rgba(15,17,21,0.03)", "dark": "rgba(244,246,248,0.04)" },
      "pressedOverlay": { "light": "rgba(15,17,21,0.06)", "dark": "rgba(244,246,248,0.08)" },
      "selectedFill":   { "light": "{primitive.cal.1000}", "dark": "{primitive.noche.textPrimary}", "comment": "Chip seleccionado: negro, no azul" },
      "onSelected":     { "light": "{primitive.cal.0}",    "dark": "{primitive.cal.1000}" }
    }
  },

  "typography": {
    "family": {
      "sans": { "value": "Archivo", "type": "fontFamily", "source": "Google Fonts", "fallback": ["Inter", "Roboto", "system-ui", "sans-serif"], "comment": "Omnibus-Type, Buenos Aires. Grotesca de señalética, variable 100-900." },
      "sansDisplay": { "value": "Archivo Expanded", "type": "fontFamily", "source": "Google Fonts", "fallback": ["Archivo", "Inter", "sans-serif"], "comment": "Opcional. Sólo para el estilo display." },
      "mono": { "value": "JetBrains Mono", "type": "fontFamily", "source": "Google Fonts", "fallback": ["Roboto Mono", "monospace"], "comment": "Sólo bloques de datos tabulares." }
    },
    "weight": {
      "regular":  { "value": 400 },
      "medium":   { "value": 500 },
      "semibold": { "value": 600 },
      "bold":     { "value": 700 },
      "extrabold":{ "value": 800 }
    },
    "style": {
      "display":    { "family": "{typography.family.sans}", "size": 44, "weight": 800, "lineHeight": 44, "letterSpacing": -0.66, "case": "none", "features": ["tnum"], "usage": "El dato principal. Uno por pantalla." },
      "h1":         { "family": "{typography.family.sans}", "size": 32, "weight": 700, "lineHeight": 36, "letterSpacing": -0.32, "case": "none" },
      "h2":         { "family": "{typography.family.sans}", "size": 26, "weight": 700, "lineHeight": 32, "letterSpacing": -0.13, "case": "none" },
      "h3":         { "family": "{typography.family.sans}", "size": 20, "weight": 600, "lineHeight": 26, "letterSpacing": -0.05, "case": "none" },
      "bodyLarge":  { "family": "{typography.family.sans}", "size": 17, "weight": 400, "lineHeight": 24, "letterSpacing": 0, "case": "none" },
      "body":       { "family": "{typography.family.sans}", "size": 15, "weight": 400, "lineHeight": 22, "letterSpacing": 0, "case": "none" },
      "bodyStrong": { "family": "{typography.family.sans}", "size": 15, "weight": 600, "lineHeight": 22, "letterSpacing": 0, "case": "none" },
      "caption":    { "family": "{typography.family.sans}", "size": 13, "weight": 400, "lineHeight": 18, "letterSpacing": 0.07, "case": "none" },
      "overline":   { "family": "{typography.family.sans}", "size": 11, "weight": 700, "lineHeight": 14, "letterSpacing": 0.88, "case": "upper", "usage": "El único uso de mayúsculas del sistema." },
      "label":      { "family": "{typography.family.sans}", "size": 16, "weight": 600, "lineHeight": 20, "letterSpacing": 0.08, "case": "none", "usage": "Botones y bottom nav." },
      "data":       { "family": "{typography.family.mono}", "size": 15, "weight": 500, "lineHeight": 20, "letterSpacing": 0, "features": ["tnum"] },
      "dataLarge":  { "family": "{typography.family.mono}", "size": 22, "weight": 700, "lineHeight": 26, "letterSpacing": -0.11, "features": ["tnum"] }
    },
    "maxScale": {
      "global":  { "value": 2.0, "comment": "El layout aguanta 200%." },
      "display": { "value": 1.6, "comment": "Clamp: a 88sp la hora no entra en una línea." },
      "overline":{ "value": 1.8 }
    }
  },

  "spacing": {
    "base": { "value": 4 },
    "scale": {
      "0":  { "value": 0 },
      "1":  { "value": 2 },
      "2":  { "value": 4 },
      "3":  { "value": 8 },
      "4":  { "value": 12 },
      "5":  { "value": 16 },
      "6":  { "value": 20 },
      "7":  { "value": 24 },
      "8":  { "value": 32 },
      "9":  { "value": 40 },
      "10": { "value": 48 },
      "11": { "value": 64 },
      "12": { "value": 80 }
    },
    "semantic": {
      "screenPaddingH":  { "value": "{spacing.scale.6}", "comment": "20" },
      "screenPaddingTop":{ "value": "{spacing.scale.9}", "comment": "40" },
      "cardPadding":     { "value": "{spacing.scale.6}", "comment": "20" },
      "cardGap":         { "value": "{spacing.scale.7}", "comment": "24" },
      "sectionGap":      { "value": "{spacing.scale.8}", "comment": "32 — el respiro que define la dirección" },
      "listItemGap":     { "value": "{spacing.scale.4}", "comment": "12" },
      "inlineGap":       { "value": "{spacing.scale.3}", "comment": "8" },
      "tightGap":        { "value": "{spacing.scale.2}", "comment": "4" },
      "emptyStateTop":   { "value": "{spacing.scale.11}", "comment": "64" }
    },
    "density": {
      "air":   { "padding": 20, "gap": 24, "usage": "Decisiones: home, pago, confirmación." },
      "list":  { "padding": 16, "gap": 12, "usage": "Conjuntos: plantel, historial." },
      "table": { "paddingV": 12, "paddingH": 16, "gap": 0, "usage": "Comparación: estadísticas, pagos." }
    },
    "grid": {
      "columns":     { "value": 4 },
      "gutter":      { "value": 16 },
      "margin":      { "value": 20 },
      "maxContentWidth": { "value": 560 },
      "maxLineChars":{ "value": 68 }
    }
  },

  "size": {
    "touchTargetMin":   { "value": 48, "comment": "Por encima de los 44 de Apple: mano mojada." },
    "buttonPrimary":    { "value": 56 },
    "buttonSecondary":  { "value": 48 },
    "buttonTertiary":   { "value": 44, "comment": "Área táctil expandida a 48." },
    "input":            { "value": 56 },
    "chip":             { "value": 28 },
    "pill":             { "value": 32 },
    "listRow":          { "value": 72 },
    "listRowCompact":   { "value": 56 },
    "tableRow":         { "value": 44 },
    "cardListItem":     { "value": 88 },
    "appBar":           { "value": 56 },
    "bottomNav":        { "value": 64 },
    "snackbarMin":      { "value": 52 },
    "badgeCaptain":     { "value": 20 },
    "avatar":  { "xs": 28, "sm": 40, "md": 56, "lg": 80 },
    "icon":    { "xs": 16, "sm": 20, "md": 24, "nav": 28, "empty": 32 },
    "iconStroke": { "default": 2, "navActive": 2.25 },
    "dot":     { "cupo": 8, "status": 10, "notification": 8 },
    "borderWidth": { "hairline": 1, "default": 1.5, "focus": 2, "accentBar": 4 }
  },

  "radius": {
    "none": { "value": 0 },
    "xs":   { "value": 6,   "usage": "Chips de posición, badges." },
    "sm":   { "value": 10,  "usage": "Botones, campos de texto." },
    "md":   { "value": 14,  "usage": "Tarjetas." },
    "lg":   { "value": 20,  "usage": "Bottom sheets (top only), diálogos." },
    "full": { "value": 999, "usage": "Avatares, pills." }
  },

  "elevation": {
    "0": { "light": { "shadow": "none" }, "dark": { "shadow": "none" }, "usage": "Default." },
    "1": {
      "light": { "shadow": "none", "border": "1px solid {color.border.subtle}" },
      "dark":  { "shadow": "none", "border": "1px solid {primitive.noche.border}" },
      "usage": "Tarjetas. La tarjeta no tiene sombra: tiene borde."
    },
    "2": {
      "light": { "shadow": "0 1px 2px 0 rgba(15,17,21,0.06)" },
      "dark":  { "shadow": "none", "border": "1px solid {primitive.noche.borderStrong}" },
      "usage": "Bottom nav, app bar al scrollear."
    },
    "3": {
      "light": { "shadow": "0 6px 16px -2px rgba(15,17,21,0.08)" },
      "dark":  { "shadow": "none", "border": "1px solid {primitive.noche.borderStrong}", "surface": "{primitive.noche.surfaceRaised}" },
      "usage": "Bottom sheet, snackbar, menú."
    },
    "4": {
      "light": { "shadow": "0 16px 40px -8px rgba(15,17,21,0.14)" },
      "dark":  { "shadow": "none", "border": "1px solid {primitive.noche.borderStrong}", "surface": "{primitive.noche.surfaceRaised}" },
      "usage": "Diálogo modal."
    }
  },

  "motion": {
    "duration": {
      "instant": { "value": 90,  "usage": "Cambio de color en pressed." },
      "fast":    { "value": 140, "usage": "Chips, checkboxes, estados." },
      "base":    { "value": 200, "usage": "Navegación, sheets, snackbar." },
      "slow":    { "value": 280, "usage": "Reordenamiento de equipos." },
      "exit":    { "value": 120, "usage": "Salidas. Siempre más rápidas que las entradas." },
      "reducedMotion": { "value": 90, "usage": "Cross-fade cuando disableAnimations == true." }
    },
    "easing": {
      "standard":  { "value": "cubic-bezier(0.2, 0, 0, 1)" },
      "accelerate":{ "value": "cubic-bezier(0.4, 0, 1, 1)" },
      "linear":    { "value": "cubic-bezier(0, 0, 1, 1)" }
    },
    "stagger": { "value": 20, "unit": "ms", "usage": "Por fila en el reordenamiento de equipos." },
    "minLoadingVisible": { "value": 400, "unit": "ms", "usage": "Para que un spinner no titile." },
    "minAiThinking":     { "value": 900, "unit": "ms", "usage": "Una decisión instantánea se lee como no pensada." },
    "rules": {
      "bounce": false,
      "overshoot": false,
      "celebration": false,
      "rippleOnPrimary": false
    }
  },

  "component": {
    "buttonPrimary": {
      "height": "{size.buttonPrimary}", "radius": "{radius.sm}", "paddingH": "{spacing.scale.7}",
      "textStyle": "{typography.style.label}",
      "bg": "{color.accent.default}", "fg": "{color.text.onAccent}",
      "bgPressed": "{color.accent.pressed}", "pressedScale": 0.98,
      "bgDisabled": "{color.accent.disabled}", "fgDisabled": "{color.text.disabled}",
      "elevation": "{elevation.0}", "maxPerScreen": 1
    },
    "buttonSecondary": {
      "height": "{size.buttonSecondary}", "radius": "{radius.sm}", "paddingH": "{spacing.scale.6}",
      "textStyle": "{typography.style.label}",
      "border": { "width": "{size.borderWidth.default}", "color": "{color.border.strong}" },
      "fg": "{color.text.primary}", "bgPressed": "{color.surface.sunken}",
      "borderDisabled": "{color.border.subtle}", "fgDisabled": "{color.text.disabled}"
    },
    "buttonTertiary": {
      "height": "{size.buttonTertiary}", "radius": "{radius.sm}", "paddingH": "{spacing.scale.4}",
      "textStyle": "{typography.style.label}",
      "fg": "{color.accent.default}", "bgPressed": "{color.accent.muted}", "fgPressed": "{color.accent.onMuted}",
      "fgDisabled": "{color.text.disabled}"
    },
    "input": {
      "height": "{size.input}", "radius": "{radius.sm}", "paddingH": "{spacing.scale.5}",
      "textStyle": "{typography.style.bodyLarge}", "labelStyle": "{typography.style.caption}",
      "labelPosition": "external", "floatingLabel": false,
      "bg": "{color.surface.primary}",
      "border": { "width": "{size.borderWidth.default}", "color": "{color.border.default}" },
      "borderHover": "{color.border.strong}",
      "borderFocused": { "width": "{size.borderWidth.focus}", "color": "{color.border.focus}" },
      "borderError": { "width": "{size.borderWidth.focus}", "color": "{color.feedback.error}" },
      "errorRequiresIcon": true,
      "bgDisabled": "{color.surface.sunken}", "fgPlaceholder": "{color.text.disabled}"
    },
    "cardMatch": {
      "radius": "{radius.md}", "padding": "{spacing.semantic.cardPadding}",
      "bg": "{color.surface.primary}", "elevation": "{elevation.1}",
      "bgPressed": "{color.surface.canvas}",
      "accentBar": { "width": "{size.borderWidth.accentBar}", "side": "left" },
      "accentBarConfirmed": "{color.feedback.success}",
      "accentBarUrgent": "{color.feedback.warningBold}",
      "cancelledBg": "{color.surface.sunken}",
      "listVariantHeight": "{size.cardListItem}",
      "cupoDot": { "size": "{size.dot.cupo}", "gap": 6, "filled": "{color.feedback.success}", "empty": "{color.border.subtle}" },
      "showVenuePhoto": false
    },
    "avatar": {
      "radius": "{radius.full}", "sizes": "{size.avatar}",
      "fallbackBg": "{color.surface.neutral}", "fallbackFg": "{primitive.cal.700}",
      "fallbackTextStyle": "{typography.style.overline}", "fallbackRatio": 0.4,
      "stackOverlap": -12, "stackMaxVisible": 5,
      "ringWidth": "{size.borderWidth.focus}",
      "statusDot": { "size": "{size.dot.status}", "ringWidth": 2 },
      "randomColorPerUser": false
    },
    "chipPosition": {
      "height": "{size.chip}", "radius": "{radius.xs}", "paddingH": 10,
      "textStyle": "{typography.style.overline}", "values": ["ARQ", "DEF", "MED", "DEL"],
      "bg": "{color.surface.neutral}", "fg": "{primitive.cal.700}",
      "selectableBg": "{color.surface.primary}", "selectableBorder": "{color.border.default}",
      "selectedBg": "{color.state.selectedFill}", "selectedFg": "{color.state.onSelected}",
      "disabledBg": "{color.surface.sunken}", "disabledFg": "{color.text.disabled}",
      "touchTarget": "{size.touchTargetMin}"
    },
    "badgeCaptain": {
      "height": "{size.badgeCaptain}", "radius": "{radius.full}", "paddingH": "{spacing.scale.3}",
      "bg": "{color.accent.default}", "fg": "{color.text.onAccent}",
      "textStyle": "{typography.style.overline}", "text": "CAP",
      "avatarRingWidth": "{size.borderWidth.focus}", "avatarRingColor": "{color.accent.default}",
      "cutoutWidth": 2,
      "comment": "Único elemento azul no tocable del sistema. No es dorado, no es escudo, no es medalla."
    },
    "bottomNav": {
      "height": "{size.bottomNav}", "bg": "{color.surface.primary}",
      "topBorder": { "width": "{size.borderWidth.hairline}", "color": "{color.border.subtle}" },
      "elevation": "{elevation.2}",
      "iconSize": "{size.icon.nav}", "labelStyle": "{typography.style.overline}", "labelGap": "{spacing.scale.2}",
      "iconInactive": "{color.icon.default}", "labelInactive": "{color.text.secondary}",
      "iconActive": "{color.icon.active}", "labelActive": "{color.icon.active}",
      "showIndicatorPill": false, "labelsAlwaysVisible": true, "hideLabelsAboveTextScale": 1.5,
      "destinations": ["Partidos", "Equipo", "Stats", "Perfil"],
      "notificationDot": { "size": "{size.dot.notification}", "color": "{color.feedback.error}", "showCount": false }
    },
    "emptyState": {
      "paddingTop": "{spacing.semantic.emptyStateTop}",
      "iconSize": "{size.icon.empty}", "iconColor": "{color.border.default}",
      "titleStyle": "{typography.style.h3}", "bodyStyle": "{typography.style.bodyLarge}",
      "bodyColor": "{color.text.secondary}", "maxWidth": 320, "bodyMaxLines": 2,
      "gapIconTitle": "{spacing.scale.6}", "gapTitleBody": "{spacing.scale.3}", "gapBodyAction": "{spacing.scale.7}",
      "useIllustration": false
    },
    "snackbar": {
      "minHeight": "{size.snackbarMin}", "radius": "{radius.sm}", "padding": "{spacing.scale.5}",
      "marginH": "{spacing.scale.5}", "marginAboveNav": "{spacing.scale.4}",
      "bg": "{color.surface.inverse}", "fg": "{color.surface.onInverse}",
      "textStyle": "{typography.style.body}",
      "actionStyle": "{typography.style.label}", "actionColor": "{primitive.azul.medio}",
      "elevation": "{elevation.3}",
      "durationDefault": 4000, "durationError": 6000, "durationWithAction": 5000,
      "iconSuccess": "{primitive.semantico.confirmadoDark}", "iconError": "{primitive.semantico.cortoDark}",
      "maxConcurrent": 1, "slideDistance": 12
    }
  },

  "a11y": {
    "minTouchTarget": 48,
    "minTouchSeparation": 8,
    "contrastTextNormal": 4.5,
    "contrastTextLarge": 3.0,
    "contrastNonText": 3.0,
    "maxTextScale": 2.0,
    "colorNeverSoleChannel": true,
    "focusRing": { "width": 2, "offset": 2, "color": "{color.border.focus}" },
    "criticalContrast": {
      "text.primary/surface.primary":  { "light": 18.9, "dark": 17.4 },
      "text.primary/surface.canvas":   { "light": 18.2, "dark": 17.4 },
      "text.secondary/surface.primary":{ "light": 6.3,  "dark": 8.7 },
      "text.tertiary/surface.primary": { "light": 4.6,  "dark": 5.9 },
      "onAccent/accent.default":       { "light": 5.9,  "dark": 6.6 },
      "accent.default/surface.primary":{ "light": 5.9,  "dark": 6.6 },
      "onAccent/accent.pressed":       { "light": 8.5,  "dark": 9.0 },
      "feedback.success/surface":      { "light": 5.4,  "dark": 8.9 },
      "feedback.error/surface":        { "light": 6.0,  "dark": 6.9 },
      "feedback.warning/surface":      { "light": 5.4,  "dark": 10.3 },
      "feedback.info/surface":         { "light": 5.8,  "dark": 9.3 }
    },
    "highContrastOverride": { "borderColor": "{color.border.highContrast}", "borderWidth": 2 }
  }
}
